---
import { Image } from 'astro:assets';
import { projects } from '@/data/projects';
import Arrow from '@/components/Arrow.astro';
---

<section
  id="projects"
  class="page-gutter section-space work-section"
  aria-labelledby="projects-title"
>
  <div class="work-heading" data-reveal>
    <h2 id="projects-title" class="heading-display">
      Projetos selecionados
    </h2>
    <p class="body-copy">
      Um olhar sobre o lugar, os materiais
      <br class="hidden lg:block" /> e a vida cotidiana.
    </p>
  </div>
  <div class="project-grid">
    {projects.map((project, index) => (
      <article
        class:list={['project', { 'project-secondary': index === 1 }]}
        data-reveal
      >
        <a
          href={`#${project.id}`}
          class="project-link"
          data-project={project.id}
          aria-haspopup="dialog"
        >
          <div class="image-frame project-image">
            <Image
              src={project.image}
              alt={project.alt}
              widths={[480, 720, 1080, 1440]}
              sizes={
                index === 0
                  ? '(min-width: 768px) 58vw, 100vw'
                  : '(min-width: 768px) 33vw, 100vw'
              }
              format="webp"
              loading="lazy"
            />
            <span class="project-open">
              Conheça o estudo <Arrow />
            </span>
          </div>
          <div class="project-caption">
            <h3>{project.title}</h3>
            <Arrow />
          </div>
          <p class="project-category">{project.category}</p>
        </a>
        <details id={project.id} class="project-fallback">
          <summary>Sobre este conceito</summary>
          <p class="body-copy mt-4">{project.description}</p>
        </details>
      </article>
    ))}
  </div>
  <p class="work-note">
    Duas casas imaginadas. Um olhar em constante construção.
  </p>
</section>
{projects.map((project) => (
  <dialog
    id={`dialog-${project.id}`}
    class="project-dialog"
    aria-labelledby={`title-${project.id}`}
  >
    <div class="dialog-top">
      <span class="eyebrow">Word / Estudo conceitual</span>
      <form method="dialog">
        <button class="dialog-close" aria-label="Fechar projeto">
          Fechar <span aria-hidden="true">×</span>
        </button>
      </form>
    </div>
    <div class="dialog-content">
      <Image
        src={project.image}
        alt={project.alt}
        width={1000}
        format="webp"
        loading="lazy"
      />
      <div class="dialog-copy">
        <p class="eyebrow">{project.category}</p>
        <h2 id={`title-${project.id}`}>{project.title}</h2>
        <p class="body-copy">{project.description}</p>
        <dl>
          <dt>Materiais</dt>
          <dd>{project.materials}</dd>
          <dt>Intenção</dt>
          <dd>{project.intention}</dd>
        </dl>
        <p class="concept-note">
          Estudo conceitual fictício com imagens geradas por IA.
        </p>
        <a class="text-link" href="#contact" data-dialog-contact>
          Converse sobre seu projeto <Arrow />
        </a>
      </div>
    </div>
  </dialog>
))}
