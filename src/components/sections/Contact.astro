---
import { Image } from 'astro:assets';
import courtyard from '@/assets/images/courtyard.png';
import Arrow from '@/components/Arrow.astro';
---

<section
  id="contact"
  class="page-gutter contact-section section-space"
  aria-labelledby="contact-title"
>
  <div class="contact-heading" data-reveal>
    <p class="eyebrow">Start a conversation</p>
    <div class="contact-title-row">
      <h2 id="contact-title" class="heading-display">
        A place to begin.
      </h2>
      <span class="contact-arrow" aria-hidden="true">
        <Arrow direction="right" />
      </span>
    </div>
  </div>
  <div class="contact-grid">
    <div class="image-frame contact-image" data-reveal>
      <Image
        src={courtyard}
        alt="Warm sunlight on a concrete garden-facing home."
        widths={[480, 720]}
        sizes="(min-width: 768px) 35vw, 100vw"
        format="webp"
        loading="lazy"
      />
    </div>
    <form id="enquiry-form" class="enquiry-form" data-reveal>
      <div class="form-pair">
        <label>
          Your name
          <input name="name" autocomplete="name" required maxlength="100" />
        </label>
        <label>
          Email address
          <input
            type="email"
            name="email"
            autocomplete="email"
            required
            maxlength="254"
          />
        </label>
      </div>
      <label class="project-field">
        Tell us about your project
        <textarea
          name="project"
          rows="4"
          required
          minlength="10"
          maxlength="5000"
          placeholder="A place, an idea, a different way of living…"
        ></textarea>
      </label>
      <div class="form-bottom">
        <button type="submit" class="solid-link" disabled>
          Prepare enquiry <Arrow />
        </button>
        <p>
          This is a concept studio. Prepare a brief to keep;
          <br class="hidden lg:block" /> your details stay in your browser.
        </p>
      </div>
      <noscript>
        <p class="body-copy mt-4">
          Enable JavaScript to prepare and download your enquiry. This demo does
          not send messages.
        </p>
      </noscript>
      <div id="enquiry-result" class="enquiry-result" hidden tabindex="-1">
        <p role="status">Your brief is ready. No message has been sent.</p>
        <a
          id="enquiry-download"
          class="text-link mt-4"
          download="word-project-enquiry.txt"
        >
          Download your enquiry <Arrow direction="down" />
        </a>
      </div>
    </form>
  </div>
</section>
