---
import { Image } from 'astro:assets';
import courtyard from '@/assets/images/courtyard.png';
import Arrow from '@/components/Arrow.astro';
---

<section
  id="contact"
  class="page-gutter contact-section section-space"
  aria-labelledby="contact-title"
>
  <div class="contact-heading" data-reveal>
    <p class="eyebrow">Vamos conversar</p>
    <div class="contact-title-row">
      <h2 id="contact-title" class="heading-display">
        Tudo começa aqui.
      </h2>
      <span class="contact-arrow" aria-hidden="true">
        <Arrow direction="right" />
      </span>
    </div>
  </div>
  <div class="contact-grid">
    <div class="image-frame contact-image" data-reveal>
      <Image
        src={courtyard}
        alt="A luz quente do sol ilumina a fachada de concreto de uma casa voltada para o jardim."
        widths={[480, 720]}
        sizes="(min-width: 768px) 35vw, 100vw"
        format="webp"
        loading="lazy"
      />
    </div>
    <form id="enquiry-form" class="enquiry-form" data-reveal>
      <div class="form-pair">
        <label>
          Seu nome
          <input name="name" autocomplete="name" required maxlength="100" />
        </label>
        <label>
          E-mail
          <input
            type="email"
            name="email"
            autocomplete="email"
            required
            maxlength="254"
          />
        </label>
      </div>
      <label class="project-field">
        Conte sobre o seu projeto
        <textarea
          name="project"
          rows="4"
          required
          minlength="10"
          maxlength="5000"
          placeholder="Um lugar, uma ideia, um novo jeito de morar…"
        ></textarea>
      </label>
      <div class="form-bottom">
        <button type="submit" class="solid-link" disabled>
          Preparar mensagem <Arrow />
        </button>
        <p>
          Este é um estúdio conceitual. Prepare um resumo do seu projeto;
          <br class="hidden lg:block" /> seus dados ficam apenas no navegador.
        </p>
      </div>
      <noscript>
        <p class="body-copy mt-4">
          Ative o JavaScript para preparar e baixar sua mensagem. Esta
          demonstração não envia mensagens.
        </p>
      </noscript>
      <div id="enquiry-result" class="enquiry-result" hidden tabindex="-1">
        <p role="status">
          Seu resumo está pronto. Nenhuma mensagem foi enviada.
        </p>
        <a
          id="enquiry-download"
          class="text-link mt-4"
          download="word-resumo-do-projeto.txt"
        >
          Baixar mensagem <Arrow direction="down" />
        </a>
      </div>
    </form>
  </div>
</section>
