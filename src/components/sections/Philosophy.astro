---
import { Image } from 'astro:assets';
import stone from '@/assets/images/stone.png';
import Arrow from '@/components/Arrow.astro';
---

<section
  id="philosophy"
  class="philosophy section-space page-gutter"
  aria-labelledby="philosophy-title"
>
  <div class="philosophy-copy" data-reveal>
    <div class="section-label">
      <span>Nossa filosofia</span>
      <span class="rule"></span>
    </div>
    <h2 id="philosophy-title" class="heading-editorial">
      Menos, com
      <br />
      mais sentido.
    </h2>
    <p class="lead">
      Acreditamos que os espaços que permanecem são aqueles que deixam a vida
      acontecer. Materiais autênticos. Luz natural. Uma conexão tranquila com o
      lugar.
    </p>
    <a href="#services" class="text-link">
      Conheça os serviços <Arrow direction="down" />
    </a>
  </div>
  <div class="image-frame philosophy-image" data-reveal>
    <Image
      src={stone}
      alt="A luz do sol incide na diagonal sobre uma parede de travertino e degraus largos de pedra."
      widths={[480, 720, 1080]}
      sizes="(min-width: 768px) 44vw, 100vw"
      format="webp"
      loading="lazy"
    />
  </div>
</section>
