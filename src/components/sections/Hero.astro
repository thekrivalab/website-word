---
import { Image } from 'astro:assets';
import courtyard from '@/assets/images/courtyard.png';
import Arrow from '@/components/Arrow.astro';
---

<section id="hero" aria-labelledby="hero-title">
  <div class="hero-copy page-gutter">
    <h1 id="hero-title">
      Espaços para
      <br />
      desacelerar.
    </h1>
    <div class="hero-aside">
      <p>
        Arquitetura com propósito.
        <br />
        Mais sentido ao morar.
      </p>
      <a href="#projects" class="text-link">
        Conheça os projetos <Arrow direction="down" />
      </a>
    </div>
  </div>
  <div class="hero-media image-frame">
    <Image
      src={courtyard}
      alt="Casa de concreto com pátio ensolarado, emoldurada por uma oliveira e lavandas."
      widths={[640, 960, 1440, 1920]}
      sizes="100vw"
      width={1920}
      format="webp"
      quality={85}
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="hero-caption page-gutter">
    <span>Arquitetura e interiores</span>
    <span>Pensado com cuidado. Vivido com calma.</span>
  </div>
</section>
