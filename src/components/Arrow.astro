---
interface Props {
  direction?: 'diagonal' | 'down' | 'right';
  class?: string;
}
const { direction = 'diagonal', class: className } = Astro.props;
const paths = {
  diagonal: 'M5 19 19 5M5 5h14v14',
  down: 'M5 5 19 19M5 19h14V5',
  right: 'M3 12h18M13 4l8 8-8 8',
};
---

<svg
  class:list={['arrow', className]}
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
>
  <path d={paths[direction]} stroke="currentColor" stroke-width="1.4" />
</svg>
