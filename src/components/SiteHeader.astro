---
import Arrow from '@/components/Arrow.astro';
import { navigation } from '@/data/site';
---

<header class="site-header page-gutter">
  <a href="#hero" class="wordmark" aria-label="Word — início">
    Word.
  </a>
  <nav class="desktop-nav" aria-label="Navegação principal">
    {navigation.map(({ href, label }) => (
      <a href={href}>{label}</a>
    ))}
    <a href="#contact" class="outline-link">
      Vamos conversar <Arrow />
    </a>
  </nav>
  <details class="mobile-menu">
    <summary>
      Menu{' '}
      <span class="menu-symbol" aria-hidden="true">
        +
      </span>
    </summary>
    <nav aria-label="Navegação móvel">
      {navigation.map(({ href, label }) => (
        <a href={href}>
          {label}
          <Arrow />
        </a>
      ))}
      <a href="#services">
        Serviços <Arrow />
      </a>
      <a href="#contact">
        Vamos conversar <Arrow />
      </a>
    </nav>
  </details>
</header>
